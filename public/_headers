# Cloudflare Pages response headers.
# Hashed build output never changes at a given URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Door frame sequences are cache-busted with ?v=; other media changes rarely.
/img/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

/logos/*
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000
