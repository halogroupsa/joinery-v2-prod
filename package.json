{
  "name": "joinery-ae",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "NEXT_PUBLIC_SITE_URL=https://joinery.ae next build",
    "verify:prod": "node scripts/verify-prod-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "pages:deploy": "npm run build:prod && npm run verify:prod && wrangler pages deploy out",
    "assets:images": "node scripts/optimize-images.mjs",
    "assets:images:prune": "node scripts/optimize-images.mjs --prune",
    "assets:posters": "node scripts/make-posters.mjs",
    "assets:og": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-og-images.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lenis": "^1.1.20",
    "lucide-react": "^0.462.0",
    "next": "^15.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ]
}
