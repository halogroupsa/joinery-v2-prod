# Set this to the current deployment URL for local, preview, or staging builds.
# Only https://joinery.ae is allowed to emit an indexable robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container and Google Ads tag. Public IDs, not secrets.
# Tags only load when NEXT_PUBLIC_SITE_URL is https://joinery.ae (i.e. build:prod),
# so staging and local builds never send data. Leave blank to disable.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# Optional: label of the Ads "lead" conversion action (the part after the slash in
# send_to "AW-XXXXXXXXXX/<label>"). Only set this if the conversion is NOT also
# configured as a tag in GTM, otherwise every lead is counted twice.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
